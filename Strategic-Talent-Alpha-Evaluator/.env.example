# ==========================================
# Talent-Alpha V7.1 Global Environment Config
# ==========================================

# --- 1. LLM Core Configuration (大模型算力配置) ---
DEEPSEEK_API_KEY=sk-xxxxxx_填入你的真实密钥_xxxxxx
DEEPSEEK_MODEL_NAME=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  # (预留备用网关)

# --- 2. System Environment (系统运行环境) ---
# 选项: development (沙盒调试) / production (实战部署)
ENVIRONMENT=production

# --- 3. Telemetry & Audit (监控与合规审计级别) ---
# 选项: DEBUG (极其详细) / INFO (常规核心节点) / WARNING (仅限异常预警)
LOG_LEVEL=INFO